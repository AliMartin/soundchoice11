<?php

/**
 * @file
 * Admin UI enhancements for Sound Choice.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function soundchoice_admin_ui_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();

  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $node = $form_object->getEntity();

  // Only alter the Artist node add/edit form.
  if ($node->bundle() !== 'artist') {
    return;
  }

  $form['#attached']['library'][] = 'soundchoice_admin_ui/artist_form';
  $form['#attributes']['class'][] = 'soundchoice-artist-form';
}
