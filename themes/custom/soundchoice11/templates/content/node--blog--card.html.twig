{#
/**
 * @file
 * Blog card view mode.
 */
#}

{%
  set classes = [
    'editorial-card',
    'card',
    'h-100',
  ]
%}

<article{{ attributes.addClass(classes) }}>

  {% if content.field_image %}
    <div class="editorial-card__image">
      <a href="{{ url }}" aria-label="View {{ node.label }}">
        {{ content.field_image }}
      </a>
    </div>
  {% endif %}

  <div class="card-body d-flex flex-column">

    <h2 class="editorial-card__title h4">
      <a href="{{ url }}">
        {{ node.label }}
      </a>
    </h2>

    {% if node.field_editorial.0.summary %}
      <div class="editorial-card__summary">
        {{ node.field_editorial.0.summary_processed }}
      </div>
    {% endif %}

    <div class="editorial-card__cta mt-auto">
      <a href="{{ url }}" class="btn btn-primary">
        <span>Read more</span>
        <i class="fa-light fa-arrow-right"></i>
      </a>
    </div>

  </div>

</article>