<header role="banner" class="site-header">

  {{ page.header }}

  {% if page.nav_branding %}
    <div class="site-header__branding">
      <div class="{{ b5_top_container }}">
        {{ page.nav_branding }}
      </div>
    </div>
  {% endif %}


  {% if page.nav_main or page.nav_additional %}
    <nav class="{{ nav_classes }} site-header__nav">

      <div class="{{ b5_top_container }} site-header__nav-inner">

        <div class="site-header__menu">
          {{ page.nav_main }}
          {{ page.nav_additional }}
        </div>

      </div>

    </nav>
  {% endif %}

</header>